---
import { messages, type Locale } from '../i18n/ui';
import type { DirectoryPageData } from '../lib/institutions/pages';
import SiteLayout from '../layouts/SiteLayout.astro';
interface Props {
  locale: Locale;
  data: DirectoryPageData;
}
const { locale, data } = Astro.props;
const t = messages[locale];
const base = locale === 'es' ? '/centros' : '/ca/centres';
---

<SiteLayout
  locale={locale}
  title={`${t.directoryTitle} · LearnAprop`}
  description={t.directoryIntro}
  section="centres"
  languagePaths={{
    es: `/centros${Astro.url.search}`,
    ca: `/ca/centres${Astro.url.search}`,
  }}
>
  <section class="centre-heading">
    <h1>{t.directoryTitle}</h1>
    <p class="intro">{t.directoryIntro}</p>
  </section>
  {data.error && (
    <p role="alert" class="error">
      {t[data.error]}
    </p>
  )}
  {!data.error && !data.centres.length && <p>{t.noCentres}</p>}
  <div class="grid centre-directory">
    {data.centres.map((centre) => (
      <article class="course">
        <h2>
          <a href={`${base}/${centre.slug}`}>{centre.name}</a>
        </h2>
        <p>
          {centre.address}, {centre.city}
        </p>
        <a href={centre.official_url}>{t.website} ↗</a>
      </article>
    ))}
  </div>
  <nav class="pagination" aria-label={t.pagination}>
    {data.page > 1 && (
      <a href={`${base}?page=${data.page - 1}`} rel="prev">
        ← {t.previous}
      </a>
    )}
    {data.hasNext && data.page < 1000 && (
      <a href={`${base}?page=${data.page + 1}`} rel="next">
        {t.next} →
      </a>
    )}
  </nav>
</SiteLayout>
