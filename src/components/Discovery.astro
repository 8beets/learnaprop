---
import {
  messages,
  formatLocalDate,
  categoryLabel,
  type Locale,
} from '../i18n/ui';
import type { DiscoveryPageData } from '../lib/courses/page';
import { formatSchedule } from '../i18n/schedule';
import { sources } from '../lib/sources';
import '../styles/global.css';

interface Props {
  locale: Locale;
  data: DiscoveryPageData;
}
const { locale, data } = Astro.props;
const t = messages[locale];
const { courses, categories, centres, filters, hasNext, error } = data;
const officialSources = sources.filter(
  (source) => !filters.centre || source.institution.id === filters.centre,
);
const base = locale === 'es' ? '/' : '/ca/';
const themes = [
  { image: 'music', label: t.photoMusic },
  { image: 'pottery', label: t.photoPottery },
  { image: 'electronics', label: t.photoElectronics },
  { image: 'woodworking', label: t.photoWoodworking },
];
function pageUrl(page: number) {
  const params = new URLSearchParams(Astro.url.searchParams);
  params.set('page', String(page));
  return `${base}?${params}`;
}
function categoryUrl(category: string) {
  return filterUrl('category', category);
}
function filterUrl(key: string, value: string) {
  const params = new URLSearchParams(Astro.url.searchParams);
  params.delete('page');
  if (value) params.set(key, value);
  else params.delete(key);
  return params.size ? `${base}?${params}` : base;
}
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={t.description} />
    <meta name="robots" content="noindex,follow" />
    <link
      rel="icon"
      type="image/png"
      href="/images/brand/learnaprop-logo.png"
    />
    <title>{t.pageTitle}</title>
  </head>
  <body>
    <a class="skip" href="#main">
      {t.skip}
    </a>
    <header class="shell header">
      <a href={base} class="brand">
        <img
          src="/images/brand/learnaprop-logo.png"
          alt=""
          width="56"
          height="56"
        />
        LearnAprop
      </a>
      <nav aria-label={t.language}>
        <a
          href={`/${Astro.url.search}`}
          lang="es"
          aria-current={locale === 'es' ? 'page' : undefined}
        >
          Español
        </a>
        <a
          href={`/ca/${Astro.url.search}`}
          lang="ca"
          aria-current={locale === 'ca' ? 'page' : undefined}
        >
          Català
        </a>
      </nav>
    </header>
    <main id="main" class="shell">
      <section class="hero" aria-labelledby="title">
        <div class="hero-copy">
          <p class="eyebrow">Barcelona · {t.mission}</p>
          <h1 id="title">{t.title}</h1>
          <p class="intro">{t.description}</p>
          <a class="hero-link" href="#discovery">
            {t.explore} <span aria-hidden="true">↓</span>
          </a>
        </div>
        <div class="hero-photos" role="group" aria-label={t.photoNote}>
          {themes.map((theme, index) => (
            <figure class={`theme-photo theme-photo-${index}`}>
              <img
                src={`/images/categories/${theme.image}.jpg`}
                alt=""
                width="800"
                height="600"
                loading={index === 0 ? 'eager' : 'lazy'}
                decoding="async"
              />
              <figcaption>{theme.label}</figcaption>
            </figure>
          ))}
        </div>
      </section>
      <div id="discovery" class="discovery-anchor"></div>
      {(centres.length > 0 || filters.centre) && (
        <nav class="categories centres" aria-label={t.centres}>
          <a
            href={filterUrl('centre', '')}
            aria-current={!filters.centre ? 'true' : undefined}
          >
            {t.allCentres}
          </a>
          {centres.map((centre) => (
            <a
              href={filterUrl('centre', centre.id)}
              aria-current={filters.centre === centre.id ? 'true' : undefined}
            >
              {centre.name}
            </a>
          ))}
        </nav>
      )}
      {(categories.length > 0 || filters.category) && (
        <nav class="categories" aria-label={t.categories}>
          <a
            href={categoryUrl('')}
            aria-current={!filters.category ? 'true' : undefined}
          >
            {t.allCategories}
          </a>
          {categories.map((category) => (
            <a
              href={categoryUrl(category)}
              aria-current={filters.category === category ? 'true' : undefined}
            >
              {categoryLabel(category, locale)}
            </a>
          ))}
        </nav>
      )}
      <form action={base} method="get" class="search" aria-label={t.submit}>
        {filters.category && (
          <input type="hidden" name="category" value={filters.category} />
        )}
        {filters.centre && (
          <input type="hidden" name="centre" value={filters.centre} />
        )}
        <div class="search-query">
          <label for="q">{t.search}</label>
          <input
            id="q"
            name="q"
            type="search"
            value={filters.q}
            aria-describedby={error === 'invalid' ? 'filter-error' : undefined}
          />
        </div>
        <div>
          <label for="maxPrice">{t.price}</label>
          <input
            id="maxPrice"
            name="maxPrice"
            type="number"
            min="0"
            max="9999.99"
            step="0.01"
            value={
              filters.maxPriceCents === null ? '' : filters.maxPriceCents / 100
            }
          />
        </div>
        <button type="submit">{t.submit}</button>
        <a href={base}>{t.clear}</a>
      </form>
      {error && (
        <p role="alert" id="filter-error" class="error">
          {t[error]}
        </p>
      )}
      <section aria-labelledby="results" class="results">
        <h2 id="results">{t.results}</h2>
        {!error && courses.length === 0 && (
          <div class="empty">
            <h3>{t.empty}</h3>
            <p>{t.emptyHelp}</p>
            {officialSources.map((source) => (
              <p>
                <a href={source.listingUrl}>
                  {t.programming}: {source.institution.name} ↗
                </a>
              </p>
            ))}
          </div>
        )}
        <div class="grid">
          {courses.map((course) => (
            <article class="course">
              <p class="institution">
                <a href={filterUrl('centre', course.institution_id)}>
                  {course.institution}
                </a>
              </p>
              {course.category && (
                <a class="course-category" href={categoryUrl(course.category)}>
                  {categoryLabel(course.category, locale)}
                </a>
              )}
              <h3>{course.title}</h3>
              <p>
                {course.start_date
                  ? formatLocalDate(course.start_date, locale)
                  : t.unknownDates}
                {course.end_date &&
                  ` – ${formatLocalDate(course.end_date, locale)}`}
              </p>
              {course.schedule_text && (
                <p class="schedule">
                  {formatSchedule(course.schedule_text, locale)}
                </p>
              )}
              <p class="price">
                {course.price_cents === null
                  ? t.unknownPrice
                  : new Intl.NumberFormat(locale, {
                      style: 'currency',
                      currency: course.currency ?? 'EUR',
                    }).format(course.price_cents / 100)}
              </p>
              <a href={course.official_url}>{t.source} ↗</a>
              <p class="verified">
                {t.verified}{' '}
                <time datetime={course.last_successfully_verified_at}>
                  {formatLocalDate(
                    course.last_successfully_verified_at.slice(0, 10),
                    locale,
                  )}
                </time>
              </p>
            </article>
          ))}
        </div>
        <nav class="pagination" aria-label={t.pagination}>
          {filters.page > 1 && (
            <a href={pageUrl(filters.page - 1)} rel="prev">
              ← {t.previous}
            </a>
          )}
          {hasNext && filters.page < 1000 && (
            <a href={pageUrl(filters.page + 1)} rel="next">
              {t.next} →
            </a>
          )}
        </nav>
      </section>
      <aside class="notice">{t.notice}</aside>
    </main>
    <footer class="shell footer">
      <p>LearnAprop</p>
      <p>{t.footer}</p>
      <a class="github-link" href="https://github.com/akira28/learnaprop">
        <img src="/icons/github.svg" alt="" width="20" height="20" />
        {t.githubRepo}
      </a>
      <p class="photo-credit">
        {t.photoNote} <a href="https://www.pexels.com/">{t.photoCredits}</a>.
      </p>
    </footer>
  </body>
</html>
