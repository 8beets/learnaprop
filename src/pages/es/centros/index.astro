---
import { env } from 'cloudflare:workers';
import CentreDirectory from '../../../components/CentreDirectory.astro';
import { loadDirectoryPage } from '../../../lib/institutions/pages';
const data = await loadDirectoryPage(env.DB, Astro.url.searchParams);
Astro.response.status = data.status;
Astro.response.headers.set('Cache-Control', 'no-store');
---

<CentreDirectory locale="es" data={data} />
