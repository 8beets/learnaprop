---
import { env } from 'cloudflare:workers';
import CentreDetail from '../../../components/CentreDetail.astro';
import { loadCentrePage } from '../../../lib/institutions/pages';
const data = await loadCentrePage(
  env.DB,
  Astro.params.slug ?? '',
  Astro.url.searchParams,
);
Astro.response.status = data.status;
---

<CentreDetail locale="es" data={data} />
