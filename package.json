{
  "name": "learnaprop",
  "version": "0.1.0",
  "private": true,
  "overrides": {
    "minimatch": "^11.0.1"
  },
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "astro check && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:types": "wrangler types --include-runtime false",
    "test:d1": "vitest run --config vitest.d1.config.ts",
    "source:verify": "tsx scripts/verify-source.ts",
    "ingest": "tsx scripts/ingest.ts",
    "ingest:live": "tsx scripts/ingest.ts --live"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.5",
    "@tailwindcss/vite": "^4.3.4",
    "astro": "^7.4.6",
    "cheerio": "^1.2.0",
    "tailwindcss": "^4.3.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@cloudflare/workers-types": "^5.20261104.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  }
}
